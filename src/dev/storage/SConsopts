Import('*')

from gem5_scons import warning

import gem5_scons

with gem5_scons.Configure(main) as conf:
    # libzstd is needed to read qcow2 images whose clusters are compressed
    # with zstd rather than zlib. It is optional: without it, such images are
    # rejected at open time with a clear message, and every other qcow2 image
    # still works.
    conf.env['CONF']['HAVE_LIBZSTD'] = bool(
        conf.CheckLibWithHeader('zstd', 'zstd.h', 'C++',
                                call='ZSTD_versionNumber();'))

    if not conf.env['CONF']['HAVE_LIBZSTD']:
        warning("Header file <zstd.h> and/or libzstd not found.\n"
                "This host has no zstd library.\n"
                "Disabling zstd cluster decompression for qcow2 disk "
                "images.")
